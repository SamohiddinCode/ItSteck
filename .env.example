# --- Database ---------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=itstek
# Host port for the database, bound to 127.0.0.1. Only needed when you run the
# backend outside Docker — pick a free one if PostgreSQL is already installed
# locally (see RUNNING.md).
POSTGRES_PORT=5432

# --- Security ----------------------------------------------------------------
# Generate one with: openssl rand -hex 32
SECRET_KEY=dev-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- App ---------------------------------------------------------------------
# Leave empty for the Docker setup — nginx serves the frontend there. Set it to
# the path of frontend/dist to run everything as a single process (Replit,
# Render, a bare VM).
STATIC_DIR=
APP_ENV=development
APP_PORT=8080
# Comma-separated. Only needed when the frontend is served from another origin.
CORS_ORIGINS=http://localhost:8080

# --- First admin -------------------------------------------------------------
# Seeded only while the users table is empty; changing these later does nothing.
FIRST_ADMIN_EMAIL=admin@itstek.com
FIRST_ADMIN_PASSWORD=admin123

# --- Telegram ----------------------------------------------------------------
# Leave empty to disable new-lead notifications. BOT_TOKEN comes from @BotFather;
# check the pair with GET /api/telegram/test once the bot is in the chat.
BOT_TOKEN=
CHAT_ID=

# --- Frontend (inlined at build time — rebuild the image after changing) ------
VITE_API_BASE_URL=/api
VITE_TELEGRAM_URL=https://t.me/itstek
VITE_INSTAGRAM_URL=https://instagram.com/itstek
# Shown in the footer and on the application page.
VITE_CONTACT_PHONE=+998920236090
